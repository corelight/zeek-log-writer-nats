#!/bin/bash
#
# Usage: private-nats-server start|stop|restart <port>
#
# A JetStream enabled nats-server for tests that pause, kill or restart
# the server, so the server shared by the other tests isn't affected. Its
# store, log and pid file live in the test's directory.
#
# Tests pause it with: kill -STOP $(cat nats-<port>.pid)

cmd=$1
port=$2
pidfile=nats-${port}.pid

start() {
    nats-server -js -p "${port}" -sd "${PWD}/nats-${port}" >>"nats-${port}.log" 2>&1 &
    echo $! >"${pidfile}"

    for _ in $(seq 1 100); do
        nats -s "nats://127.0.0.1:${port}" account info >/dev/null 2>&1 && return 0
        sleep 0.1
    done

    echo "nats-server on port ${port} didn't start" >&2
    return 1
}

stop() {
    [ -f "${pidfile}" ] || return 0
    pid=$(cat "${pidfile}")
    kill -CONT "${pid}" 2>/dev/null
    kill "${pid}" 2>/dev/null
    for _ in $(seq 1 100); do
        kill -0 "${pid}" 2>/dev/null || break
        sleep 0.1
    done
    rm -f "${pidfile}"
}

case "${cmd}" in
    start) start ;;
    stop) stop ;;
    restart)
        stop
        start
        ;;
    *)
        echo "usage: $0 start|stop|restart <port>" >&2
        exit 1
        ;;
esac
