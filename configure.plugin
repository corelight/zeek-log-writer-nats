#!/bin/sh
#
# Hooks to add custom options to the configure script.
# Automated template updates will leave this file untouched.
#

plugin_usage()
{
    : # Do nothing
    cat <<EOF
    --with-libnats-root=DIR          Path to libnats
    --with-orbit-root=DIR            Path to orbit.c (fast-ingest support)
EOF
}

plugin_option()
{
    case "$1" in
        --with-libnats-root=*)
            append_cache_entry LIBNATS_ROOT_DIR PATH $optarg
            return 0
            ;;

        --with-orbit-root=*)
            append_cache_entry ORBIT_ROOT_DIR PATH $optarg
            return 0
            ;;

        *)
            return 1;
            ;;
    esac
}

plugin_addl()
{
    : # Do nothing
}
